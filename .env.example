# ============================================================
# Whois Watcher — переменные окружения
# Скопируйте этот файл в .env и заполните значения.
# НИКОГДА не коммитьте .env в репозиторий!
# ============================================================

# ---------- Telegram Bot ----------
# Токен бота, полученный от @BotFather
BOT_TOKEN=

# Базовый публичный URL для webhook (без trailing slash)
# Пример: https://bot.example.com
WEBHOOK_BASE_URL=

# Путь webhook (произвольная строка для безопасности)
# Пример: /webhook/abc123def456
WEBHOOK_PATH=/webhook

# Секрет для верификации запросов от Telegram (любая строка 1-256 символов)
# Telegram будет слать его в заголовке X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET=

# Хост и порт, на котором слушает внутренний webhook-сервер
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# ---------- База данных ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=whoiswatcher
POSTGRES_PASSWORD=
POSTGRES_DB=whoiswatcher

# DSN формируется автоматически из переменных выше, либо переопределите целиком:
# POSTGRES_DSN=postgresql+asyncpg://user:pass@host:5432/db

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://redis:6379/0  # альтернатива

# ---------- Админский канал ----------
# ID канала или группы для алертов (формат: -100xxxxxxxxxx).
# Бот должен быть добавлен в канал с правом отправки сообщений.
# Пусто → алерты выключены (no-op + warning в лог).
ADMIN_CHANNEL_ID=

# ID администраторов через запятую (например: 12345,67890).
# Используется командой /admin (stats, тестовая отправка алерта).
ADMIN_USER_IDS=

# ---------- Идентификатор инстанса (ADR 019, TASK-0019) ----------
# Метка деплоя — произвольное имя, чтобы различать серверы в алертах.
# Пример: prod-admin, staging, worker-1. Пусто → не используется.
INSTANCE_NAME=
# Публичный IP сервера — показывается в алертах (только в админ-канале).
# Пусто → не используется. НЕ автоопределяется — задаётся вручную.
SERVER_IP=

# ---------- Мониторинг ----------
SENTRY_DSN=
LOG_LEVEL=INFO
ENVIRONMENT=development  # development | production

# ---------- Лимиты (см. src/config/limits.py для дефолтов) ----------
# Можно переопределить любой лимит через env. Примеры:
# MAX_DOMAINS_PER_USER=50000
# MAX_ADD_PER_HOUR=100
# MAX_WHOIS_PER_MINUTE=20
# MAX_CONCURRENT_WHOIS=50

# ---------- Дефолтные настройки нового пользователя ----------
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_LANGUAGE=ru
DEFAULT_NOTIFY_HOUR=9

# ---------- Прочее ----------
# Имя бота для текстов (отображается в /start и т.п.)
BOT_NAME=Whois Watcher
BOT_USERNAME=  # username бота без @, например whois_watcher_bot

# ---------- WHOIS proxy (recommended, ADR 028) ----------
# Локальный proxy-gateway сам выбирает upstream (RDAP / WHOIS:43 /
# выделенный RU-relay для .ru/.рф/.su) и кэширует ответы на 24 часа.
# Если прокси упал, бот делает fallback на прямой RDAP+WHOIS:43 lookup.
WHOIS_PROXY_ENABLED=true
# При запуске через docker compose — используй host.docker.internal:
# контейнеры читают это имя через ``extra_hosts: host-gateway`` в
# ``docker-compose.yml``. Это путь к loopback-у хоста.
WHOIS_PROXY_URL=http://host.docker.internal:8043
# При запуске напрямую (без docker, для разработки) — 127.0.0.1:
# WHOIS_PROXY_URL=http://127.0.0.1:8043
WHOIS_PROXY_TIMEOUT=15

# WHOIS_SERVER_OVERRIDES — УДАЛЁН в v0.4.0 (Этап 10). Заменён прокси:
# см. docs/decisions.md ADR 028 и DEPRECATED ADR 023.

# ---------- WHOIS referral following ----------
# Делать ли второй WHOIS-запрос на ``Registrar WHOIS Server`` для thin-WHOIS
# реестров (.com/.net): полнее данные, +1 TCP-соединение к серверу регистратора.
# По умолчанию включено. Выключите, если ваш хостинг блокирует исходящий 43-й
# порт на внешние сервера регистраторов.
# WHOIS_REFERRAL_FOLLOWING=true

# ---------- Backups (ADR 042, TASK-0058) ----------
# Ежечасный pg_dump (выполняется в scheduler-контейнере).
# В docker-compose том `backups` монтируется на этот путь для worker/scheduler.
BACKUP_DIR=/backups
BACKUP_KEEP=36
BACKUP_MIN_BYTES=1024
